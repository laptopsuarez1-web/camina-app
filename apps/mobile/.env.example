EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Login con Google (src/lib/oauth.ts) — Client IDs de un proyecto en
# https://console.cloud.google.com/apis/credentials. Con que uno de los tres
# esté seteado ya se habilita el botón; que corresponda al build que estés
# probando (iOS/Android nativo, o Web si probás en un navegador).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
