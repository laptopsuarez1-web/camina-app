{
  "expo": {
    "name": "Camina",
    "slug": "camina",
    "scheme": "camina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#8B4FD1",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#200a52"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bo.camina.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Camina usa tus pasos para calcular los Puntos que ganas caminando.",
        "NSLocationWhenInUseUsageDescription": "Camina usa tu ubicación para mostrarte los comercios y beneficios más cercanos.",
        "NSHealthShareUsageDescription": "Camina lee tus pasos de Salud para calcular los Puntos que ganas caminando.",
        "NSHealthUpdateUsageDescription": "Camina no escribe datos en Salud, solo lee tus pasos.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "camina",
              "bo.camina.app"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.326158603986-6shm71vlt0a7qt6rp7mi25pc2dg3chga"
            ]
          }
        ]
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:caminaapp.com"
      ]
    },
    "android": {
      "package": "bo.camina.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#200a52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "android.permission.health.READ_STEPS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCF6Z1N9XpgIlvGKX22z97XUaZw00Q5np8"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "caminaapp.com",
              "pathPrefix": "/r"
            },
            {
              "scheme": "https",
              "host": "caminaapp.com",
              "pathPrefix": "/join-group"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4FC3A8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Camina usa tu ubicación para mostrarte los comercios y beneficios más cercanos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#200a52"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Camina lee tus pasos de Salud para calcular los Puntos que ganas caminando.",
          "NSHealthUpdateUsageDescription": "Camina no escribe datos en Salud, solo lee tus pasos."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyCF6Z1N9XpgIlvGKX22z97XUaZw00Q5np8"
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "photosPermission": "Camina usa tus fotos para tu foto de perfil y para la historia de lo que canjeaste.",
          "cameraPermission": "Camina usa la cámara para sacarle una foto a lo que canjeaste y subirla a tu historia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b0cfd55-9922-4731-b971-f614435ac781"
      }
    },
    "owner": "marcos2114"
  }
}
